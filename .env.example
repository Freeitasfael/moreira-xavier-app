# ===========================================
# Moreira e Xavier - Variáveis de Ambiente
# ===========================================

# Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Banco de Dados (PostgreSQL)
DATABASE_URL="postgresql://moreira:xavier2024@localhost:5432/moreira_xavier?schema=public"

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=sua-chave-secreta-alterar-em-producao-min-32-chars
JWT_EXPIRES_IN=7d

# Criptografia (AES-256 para credenciais dos tribunais)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=alterar-para-chave-hex-64-caracteres-gerada-com-crypto

# DataJud API (CNJ)
DATAJUD_API_KEY=sua-chave-api-datajud
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
EMAIL_FROM="Moreira e Xavier <noreply@moreiraxavier.com.br>"

# Scraping
SCRAPING_CONCURRENCY=3
SCRAPING_DELAY_MIN=2000
SCRAPING_DELAY_MAX=5000
SCRAPING_HEADLESS=true

# Logs
LOG_LEVEL=info
